# --- LLM ---
# Set LLM_MOCK=false and fill LLM_API_KEY to use a real model via LiteLLM.
LLM_MOCK=true
LLM_API_KEY=
LLM_MODEL=deepseek/deepseek-chat
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_FALLBACK_MODEL=qwen/qwen-2.5-coder-32b-instruct

# --- App ---
APP_ENV=development
JWT_SECRET=change-me-in-production-please-use-32b+
JWT_EXPIRE_HOURS=72
DATABASE_URL=sqlite:///./atoms.db
DATA_DIR=./data

# --- Limits ---
RATE_LIMIT_DAILY=5
MAX_CONCURRENT_TASKS=3
MAX_FIX_ROUNDS=2
MAX_RUNTIME_FIX=2
MAX_FILE_SIZE_KB=200
MAX_PROJECT_SIZE_KB=2048
MAX_VERSIONS=50
MAX_FILES_PER_PROJECT=8

# --- CORS (dev only; production serves frontend from the same origin) ---
CORS_ORIGINS=http://localhost:5176,http://127.0.0.1:5176,http://localhost:5173
